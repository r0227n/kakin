      "name": "budget_rates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budget_rates\" (\"effective_month\" TEXT NOT NULL CHECK (date(effective_month || '-01') IS effective_month || '-01'), \"amount_yen\" INTEGER NOT NULL CHECK (amount_yen >= 0), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"effective_month\"));"
        }
      ]
    },
    {
      "name": "budget_overrides",
      "sql": [
