          "sql": "CREATE TABLE IF NOT EXISTS \"budget_overrides\" (\"month\" TEXT NOT NULL CHECK (date(month || '-01') IS month || '-01'), \"amount_yen\" INTEGER NOT NULL CHECK (amount_yen >= 0), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"month\"));"
        }
      ]
    },
    {
      "name": "performances",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"performances\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"starts_at\" TEXT NOT NULL, \"venue\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "partners",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"partners\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"group_name\" TEXT NULL, \"icon_file\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "ticket_applications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ticket_applications\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"performance_id\" INTEGER NOT NULL REFERENCES performances (id) ON DELETE CASCADE, \"service\" TEXT NULL, \"stage\" TEXT NOT NULL, \"reference_no\" TEXT NULL, \"apply_deadline_at\" TEXT NULL, \"result_at\" TEXT NULL, \"payment_deadline_at\" TEXT NULL, \"note\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, CHECK (stage IN ('planned', 'awaiting_result', 'awaiting_payment', 'secured', 'lost')), CHECK (service IS NULL OR service IN ('eplus', 'livepocket', 'other')));"
        }
      ]
    },
    {
      "name": "email_imports",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"email_imports\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"account_email\" TEXT NOT NULL, \"gmail_message_id\" TEXT NOT NULL, \"service\" TEXT NOT NULL, \"mail_kind\" TEXT NOT NULL, \"ticket_application_id\" INTEGER NULL REFERENCES ticket_applications (id) ON DELETE SET NULL, \"subject\" TEXT NOT NULL, \"received_at\" TEXT NOT NULL, \"imported_at\" TEXT NOT NULL, UNIQUE (\"account_email\", \"gmail_message_id\"), CHECK (service IN ('eplus', 'livepocket')), CHECK (mail_kind IN ('application', 'win', 'lose', 'payment')));"
        }
      ]
    },
    {
      "name": "expenses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expenses\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"category\" TEXT NOT NULL, \"amount_yen\" INTEGER NOT NULL CHECK (amount_yen >= 0), \"paid_on\" TEXT NOT NULL CHECK (date(paid_on) IS paid_on), \"performance_id\" INTEGER NULL REFERENCES performances (id) ON DELETE SET NULL, \"partner_id\" INTEGER NULL REFERENCES partners (id) ON DELETE RESTRICT, \"shot_count\" INTEGER CHECK (shot_count > 0), \"email_import_id\" INTEGER NULL REFERENCES email_imports (id) ON DELETE SET NULL, \"note\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, CHECK (category IN ('ticket', 'drink', 'cheki', 'goods', 'transport', 'locker', 'other')), CHECK (category NOT IN ('ticket', 'drink', 'cheki') OR performance_id IS NOT NULL), CHECK ((category = 'cheki' AND partner_id IS NOT NULL AND shot_count IS NOT NULL) OR (category <> 'cheki' AND partner_id IS NULL AND shot_count IS NULL)));"
        }
      ]
    },
    {
      "name": "gmail_sync_states",
      "sql": [
        {
          "dialect": "sqlite",
